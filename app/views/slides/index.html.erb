<div data-controller="slideshow" class="min-h-screen bg-stone-950">

  <%# Icon grid %>
  <div
    data-slideshow-target="grid"
    class="grid grid-cols-4 sm:grid-cols-5 md:grid-cols-6 lg:grid-cols-7 gap-3 p-6"
    style="transition: opacity 0.4s"
  >
    <% @icons.each do |icon| %>
      <div
        class="cursor-pointer rounded-2xl overflow-hidden aspect-square bg-stone-800 hover:scale-105 hover:brightness-110 transition-transform duration-200"
        data-action="click->slideshow#open"
        data-icon-src="<%= icon[:file] %>"
        data-photos="<%= icon[:photos].to_json %>"
      >
        <img src="<%= icon[:file] %>" class="w-full h-full object-cover" draggable="false">
      </div>
    <% end %>
  </div>

  <%# Floating icon — animates from grid position to corner %>
  <div
    data-slideshow-target="floatingIcon"
    class="fixed z-50 rounded-2xl overflow-hidden pointer-events-none hidden"
  >
    <img data-slideshow-target="floatingIconImg" class="w-full h-full object-cover" draggable="false">
  </div>

  <%# Slideshow overlay %>
  <div
    data-slideshow-target="overlay"
    class="fixed inset-0 z-40 bg-black cursor-pointer hidden"
    data-action="click->slideshow#advance"
    style="opacity: 0"
  >
    <%# Small icon pinned to top-left once animation completes %>
    <img
      data-slideshow-target="iconThumb"
      class="absolute top-4 left-4 w-20 h-20 rounded-2xl object-cover z-10"
      style="opacity: 0; transition: opacity 0.2s"
      draggable="false"
    >

    <%# Photo counter pinned to top-right %>
    <div
      data-slideshow-target="counter"
      class="absolute top-6 right-6 z-10 text-white text-lg font-semibold tracking-wide"
      style="opacity: 0; transition: opacity 0.2s; text-shadow: 0 1px 4px rgba(0,0,0,0.6)"
    ></div>

    <%# Main photo %>
    <img
      data-slideshow-target="photo"
      class="absolute inset-0 w-full h-full object-contain"
      style="opacity: 0; transition: opacity 0.4s"
      draggable="false"
    >
  </div>

</div>
